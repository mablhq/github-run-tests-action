{
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "lib/",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "strict": true,
    "target": "es2022",
    "esModuleInterop": true
  }
}
